{
  "name": "not-too-far",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "postinstall": "node -e \"try { const fs=require('fs'); if(fs.existsSync('./node_modules/@rollup/wasm-node')) { fs.cpSync('./node_modules/@rollup/wasm-node/dist/wasm-node', './node_modules/rollup/dist/wasm-node', {recursive:true}); fs.copyFileSync('./node_modules/@rollup/wasm-node/dist/native.js', './node_modules/rollup/dist/native.js'); } } catch(e){}\""
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.63.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node"
  }
}
